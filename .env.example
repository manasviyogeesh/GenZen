PORT=4000
DATABRICKS_APP_PORT=8787
PGHOST=
PGPORT=
PGDATABASE=databricks_postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Databricks SQL connection (configured only on the server).
# DATABRICKS_HOST may be https://your-workspace.cloud.databricks.com or the workspace hostname.
DATABRICKS_HOST="https://your-workspace.cloud.databricks.com"
DATABRICKS_TOKEN="dapi..."
DATABRICKS_WAREHOUSE_ID="your-sql-warehouse-id"
DATABRICKS_CATALOG="workspace"
DATABRICKS_SCHEMA="default"

# Databricks Genie proxy settings.
GENIE_SPACE_ID="YOUR_GENIE_SPACE_ID"
